# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file or share your API key.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model ID shown in Google AI Studio, e.g. a Gemini Flash model. Required for live AI results.
GEMINI_MODEL=

DATABASE_URL=sqlite:///./pocketsmart.db
# Long random string used to sign login session cookies.
SECRET_KEY=

# ---- Optional settings (defaults shown) ----
# Seconds to wait for Gemini before giving up
GEMINI_TIMEOUT_SECONDS=60
# Set to true to force demo mode (sample data, no Gemini calls)
DEMO_MODE=false
# Max outfit-image size in MB
MAX_UPLOAD_MB=5
HOST=127.0.0.1
PORT=8000
RELOAD=true
